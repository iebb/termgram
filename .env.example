# Create credentials at https://my.telegram.org/apps
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-me

# Optional. Defaults to the platform application data directory.
# TERMGRAM_SESSION=/absolute/path/to/termgram.session

# Optional. SOCKS5 or HTTP proxy for Telegram connections, for example:
# TERMGRAM_PROXY=socks5://127.0.0.1:9050
# TERMGRAM_PROXY=http://proxy.local:3128
# When set, connections never fall back to a direct one; an invalid
# value disables proxying with a startup warning.
